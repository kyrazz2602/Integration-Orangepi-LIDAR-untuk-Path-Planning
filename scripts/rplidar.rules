# set the udev rules for robot hardware interfaces

# RPLidar A1 (Slamtec CP210x) -> /dev/rplidar
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0777", GROUP="dialout", SYMLINK+="rplidar"

# Arduino Mega 2560 (Original Atmega16U2) -> /dev/arduino
KERNEL=="ttyACM*", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0042", MODE:="0777", GROUP="dialout", SYMLINK+="arduino"

# Arduino Mega 2560 Clone (CH340 USB-Serial) -> /dev/arduino
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0777", GROUP="dialout", SYMLINK+="arduino"

# Orange Pi Hardware UART4 (ttyAS4) -> /dev/arduino
KERNEL=="ttyAS4", MODE:="0777", GROUP="dialout", SYMLINK+="arduino"

# ESP32 on Hardware UART7 (ttyAS7) -> /dev/esp32
KERNEL=="ttyAS7", MODE:="0777", GROUP="dialout", SYMLINK+="esp32"

